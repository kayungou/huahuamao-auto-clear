[Unit]
Description=闯关助手 Web 控制台（Go + 内嵌 Vue 前端）
Documentation=file:///opt/sgz-web/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/sgz-web
ExecStart=/opt/sgz-web/sgz-web -host 0.0.0.0 -port 8902 -open=false
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
